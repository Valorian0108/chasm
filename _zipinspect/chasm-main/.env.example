# Runtime
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/claims_checker

# AI analysis
ANALYSIS_PROVIDER=ai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com
# Netlify also needs OPENAI_API_KEY set in Site configuration > Environment variables.

# X Layer
X_LAYER_TARGET_NETWORK=xlayer-testnet
X_LAYER_WALLET_ADDRESS=0xf52a8c9f07446604743ffe60b7fbf75e9d16d9ff
X_LAYER_CONTRACT_ADDRESS=0xa3a9fFddE592AE2D889562d9ca2B05d9Ae5634b3
X_LAYER_TESTNET_CHAIN_ID=1952
X_LAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech/terigon
X_LAYER_TESTNET_EXPLORER_URL=https://www.okx.com/web3/explorer/xlayer-test
X_LAYER_MAINNET_CHAIN_ID=196
X_LAYER_MAINNET_RPC_URL=https://rpc.xlayer.tech
X_LAYER_MAINNET_EXPLORER_URL=https://www.okx.com/web3/explorer/xlayer
X_LAYER_FAUCET_URL=https://www.okx.com/xlayer/faucet

# Public frontend fallbacks for static hosts like Netlify
VITE_X_LAYER_WALLET_ADDRESS=0xf52a8c9f07446604743ffe60b7fbf75e9d16d9ff
VITE_X_LAYER_CONTRACT_ADDRESS=0xa3a9fFddE592AE2D889562d9ca2B05d9Ae5634b3

# Optional legacy aliases
# AI_API_KEY=
